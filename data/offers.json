      "name": "One-time credit that runs out",
      "explanation": "A sum of money given away to spend. When it is gone, it is gone."
    },
    {
      "id": "time-limited-free",
      "name": "Free for a limited time",
      "explanation": "Free for N months, and after that it is charged or shut down."
    },
    {
      "id": "time-subscription",
      "name": "Time-based subscription",
      "explanation": "Fixed price per month or per year, no matter how much you use."
    },
    { "id": "metered-usage", "name": "Metered usage", "explanation": "You pay exactly for what you consume, with no minimum." },
    {
      "id": "base-plus-overage",
      "name": "Fixed base plus overage",
      "explanation": "A fixed fee that includes a certain amount of usage, plus a rate for whatever goes beyond it."
    },
    {
      "id": "per-transaction",
      "name": "Per transaction",
      "explanation": "A fee on each operation, usually a percentage plus a fixed amount."
    }
